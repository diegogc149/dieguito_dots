set preview true
set previewer ~/.config/lf/pv.sh
set cleaner ~/.config/lf/clean.sh
set drawbox true
set icons true
set hidden true

cmd open ${{
    mime_type=$(file -Lb --mime-type "$f")

    case "$mime_type" in
        image/*)
            setsid -f feh --start-at "$f" "$(dirname -- "$f")" >/dev/null 2>&1
            ;;
        video/*|audio/*)
            setsid -f mpv "$f" >/dev/null 2>&1
            ;;
        application/pdf)
            setsid -f zathura "$f" >/dev/null 2>&1
            ;;
        *)
            nvim "$f"
            ;;
    esac
}}

map <enter> open
map e $nvim "$f"
